# --- SunProof Demo Configuration ---
# Set SUNPROOF_USE_LLM=1 and provide ANTHROPIC_API_KEY to use live Claude explanations
# (verified by the numeric guardrail; falls back to deterministic templates if omitted)
SUNPROOF_USE_LLM=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Set both Telegram variables to send real O&M alerts to your phone/group during the demo
# (otherwise alerts run in simulated preview mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
